diff --git a/udiskie/service.luau b/udiskie/service.luau
index 236bff6..9f2a3c6 100644
--- a/udiskie/service.luau
+++ b/udiskie/service.luau
@@ -242,7 +242,9 @@ function onIpc(event, payload)
             fetchDevices()
         end, 10000)
     elseif event == "eject" and payload then
-        noctalia.runAsync("udiskie-umount -e " .. shellQuote(payload), function(res)
+        -- USB disks aren't "ejectable" (udiskie refuses); unmount all partitions, then power off instead.
+        local dev = shellQuote(payload)
+        noctalia.runAsync("udiskie-umount -f -e " .. dev .. " || udiskie-umount -f -d " .. dev, function(res)
             if res and res.exitCode ~= 0 and noctalia.getConfig("enable_notifications") ~= false then
                 noctalia.notifyError(noctalia.tr("notif_eject_failed_title"), cleanError(res.stderr, noctalia.tr("notif_eject_failed_fallback", { device = payload })))
             end
