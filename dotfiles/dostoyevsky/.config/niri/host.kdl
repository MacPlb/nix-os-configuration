// dostoyevsky: Latitude 5531 internal panel and touchpad. External monitors use niri's
// automatic placement; pin them here with `output` blocks if needed.

input {
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

output "eDP-1" {
    scale 1.0
}

// Smaller mouse pointer than the default 24 on the 1x panel. Adwaita's smallest size is 24,
// so 16 needs Bibata (installed in modules/hosts/dostoyevsky/configuration.nix).
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 16
}
