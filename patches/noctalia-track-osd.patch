+std::optional<float> Bar::mediaCenterForOutput(wl_output* output) const {
+  // shortcut: anchors to the current full-width top bar, extend if the bar moves or becomes floating.
+  for (const auto& instance : m_instances) {
+    if (instance->output != output || instance->surface == nullptr
+        || instance->barConfig.position != "top" || !barContentVisuallyShown(*instance)) {
+      continue;
+    }
+    for (const auto* widgets : {&instance->startWidgets, &instance->centerWidgets, &instance->endWidgets}) {
+      for (const auto& widget : *widgets) {
+        if (dynamic_cast<const MediaWidget*>(widget.get()) == nullptr) {
+          continue;
+        }
+        const Node* root = widget->outerNode();
+        if (root == nullptr || !root->visible() || root->width() <= 0.0F) {
+          continue;
+        }
+        float x = 0.0F, y = 0.0F;
+        Node::absolutePosition(root, x, y);
+        return instance->surface->marginLeft() + x + root->width() / 2.0F;
+      }
+    }
+  }
+  return std::nullopt;
+}
